# Expo public env vars – SRS §9.1 API Endpoints

EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_WS_URL=ws://localhost:3000

# Chạy Expo Go trên điện thoại (cùng mạng Wi-Fi với máy chạy backend; Expo Go phải cùng phiên bản SDK với app):
# điện thoại không gọi được localhost, nên comment hai dòng trên và bật hai dòng dưới, thay <IPv4> bằng IP LAN của máy (ipconfig)
# EXPO_PUBLIC_API_URL=http://<IPv4>:3000
# EXPO_PUBLIC_WS_URL=ws://<IPv4>:3000
