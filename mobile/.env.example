# Expo public env vars – SRS §9.1 API Endpoints

EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_WS_URL=ws://localhost:3000
# Gốc HLS của MediaMTX (live stream camera AI, VISION-FR-013) — MediaMTX phải bật hls (cổng 8888).
# Production dùng https:// (token xem nằm trong query của URL), API/WS cũng vậy: https:// và wss://
EXPO_PUBLIC_STREAM_URL=http://localhost:8888
# Dữ liệu mẫu cho mục Report 3 đã có màn mà backend chưa có route (constants/mockApi.ts). Bỏ trống = bật khi chạy dev;
# false = các khối đó hiện "Sắp có". Dữ liệu mẫu luôn có nhãn "Dữ liệu mẫu"
# EXPO_PUBLIC_USE_MOCK_API=true

# Chạy Expo Go trên điện thoại (cùng mạng Wi-Fi với máy chạy backend; Expo Go phải cùng phiên bản SDK với app):
# điện thoại không gọi được localhost, nên comment hai dòng trên và bật hai dòng dưới, thay <IPv4> bằng IP LAN của máy (ipconfig)
# EXPO_PUBLIC_API_URL=http://<IPv4>:3000
# EXPO_PUBLIC_WS_URL=ws://<IPv4>:3000
# EXPO_PUBLIC_STREAM_URL=http://<IPv4>:8888
