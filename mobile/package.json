    "axios": "~1.7.0",
    "burnt": "~0.13.0",
    "date-fns": "~4.1.0",
    "expo": "~58.0.19",
    "expo-asset": "~58.0.18",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-keep-awake": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "phosphor-react-native": "^3.0.6",
    "query-string": "^7.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
