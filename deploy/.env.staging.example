# Staging (deploy/docker-compose.staging.yml). Chép thành deploy/.env.staging trên VPS, không commit bản thật.
# Tạo chuỗi ngẫu nhiên: openssl rand -hex 32

# Một tên miền cho web, /api, /socket.io, /stream (WHEP), MQTT 8883 và RTSPS 8322
DOMAIN=CHANGE_ME.example.com
# E-mail nhận thông báo hết hạn chứng chỉ của Let's Encrypt
CERTBOT_EMAIL=CHANGE_ME@example.com
# IP công khai của VPS, để trình duyệt nối WebRTC tới MediaMTX
PUBLIC_IP=CHANGE_ME

MONGO_USER=swiftletcare
MONGO_PASSWORD=CHANGE_ME

JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME

# Tài khoản broker của backend (tên cố định backend-service) và khoá EMQX dùng khi hỏi /internal/mqtt-auth
MQTT_PASSWORD=CHANGE_ME
MQTT_AUTH_KEY=CHANGE_ME
EMQX_COOKIE=CHANGE_ME
EMQX_DASHBOARD_PASSWORD=CHANGE_ME

# Live stream (VISION-FR-013): token người xem, khoá MediaMTX gọi /internal/stream-auth, mật khẩu nút AI đẩy video
STREAM_TOKEN_SECRET=CHANGE_ME
STREAM_AUTH_KEY=CHANGE_ME
STREAM_PUBLISH_SECRET=CHANGE_ME
# Khoá lưu mật khẩu camera (openssl rand -base64 32); giữ cố định, mất thì phải nhập lại mật khẩu mọi camera
CAMERA_SOURCE_KEY=CHANGE_ME

# Không bắt buộc: để trống thì kênh đó không gửi (push FCM cần file deploy/secrets/firebase-service-account.json)
# Compose chỉ đọc file này, không đọc backend/.env*. Sửa xong chạy `up -d backend` (restart không nạp lại biến)
RATE_LIMIT_MAX=300
# Host HTTPS được phép cho lệnh OTA gửi tay tới một URL (đợt cập nhật firmware không cần). VD: chính DOMAIN
OTA_ALLOWED_HOSTS=
# Bot riêng cho staging: một token chỉ chạy được trên một backend (long polling). Username không có @
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Thư tài khoản (lời mời, mã đặt lại mật khẩu, mật khẩu tạm). Để trống = không gửi thư, chỉ ghi cảnh báo vào log
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=<gmail>, SMTP_PASS=<App Password viết liền, không dấu cách>
# Brevo (gửi dưới tên miền riêng): SMTP_HOST=smtp-relay.brevo.com, SMTP_USER=<login SMTP>, SMTP_PASS=<SMTP key>,
# SMTP_FROM=noreply@<DOMAIN> (tên miền phải đã xác thực SPF/DKIM trên Brevo)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
