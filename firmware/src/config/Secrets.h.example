/**
 * Secrets.h.example – Mẫu file chứa WiFi/MQTT credentials thật.
 *
 * CÁCH DÙNG:
 *   1. Copy file này thành "Secrets.h" (cùng thư mục) — KHÔNG đổi tên khác.
 *   2. Điền giá trị thật của bạn vào Secrets.h.
 *   3. Secrets.h đã được thêm vào .gitignore → KHÔNG bao giờ bị commit lên GitHub.
 *
 * Nếu thiếu Secrets.h, biên dịch sẽ báo lỗi "Secrets.h: No such file" — đó là
 * chủ đích, để không ai vô tình build với giá trị rác.
 */
#pragma once

// ── WiFi nhà/farm của bạn (chỉ hỗ trợ băng tần 2.4GHz) ───────────────────────
#define SECRET_WIFI_SSID     "TEN_WIFI_CUA_BAN"
#define SECRET_WIFI_PASSWORD "MAT_KHAU_WIFI_CUA_BAN"

// ── MQTT Broker ───────────────────────────────────────────────────────────────
// Địa chỉ IP LAN của máy đang chạy `docker compose up -d` (EMQX), VÍ DỤ
// "192.168.1.23" — lấy bằng lệnh `ipconfig` (Windows) trên máy đó, mục
// "IPv4 Address" của adapter WiFi đang dùng. KHÔNG dùng "localhost": ESP32 là
// một thiết bị khác trên mạng, không phải máy bạn.
#define SECRET_MQTT_BROKER   "192.168.1.23"
#define SECRET_MQTT_USERNAME "esp32_node"
#define SECRET_MQTT_PASSWORD "mqtt_secret" // giá trị bất kỳ khi EMQX đang allow_anonymous=true (dev)

// ── Định danh thiết bị (khớp Farm/House/Zone đã tạo trên backend) ────────────
#define SECRET_FARM_ID   "farm_001"
#define SECRET_HOUSE_ID  "house_001"
#define SECRET_ZONE_ID   "zone_001"
#define SECRET_DEVICE_ID "node_001"

// ── OTA (cập nhật firmware qua WiFi, http://<ip-esp32>/update) ──────────────
// Đặt mật khẩu riêng — cổng này mở trên mạng LAN, ai biết mật khẩu đều nạp
// được firmware mới vào thiết bị.
#define SECRET_OTA_USERNAME "admin"
#define SECRET_OTA_PASSWORD "DOI_MAT_KHAU_OTA_NAY"
