# ── App ────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME=SwiftletCare API

# ── MongoDB (user/pass root khớp docker-compose.yml ở gốc repo) ──────────────
MONGODB_URI=mongodb://admin:swiftletcare_dev@localhost:27017/swiftletcare?authSource=admin
MONGODB_TEST_URI=mongodb://admin:swiftletcare_dev@localhost:27017/swiftletcare_test?authSource=admin

# ── Redis (for session / rate limiting) ───────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT (AUTH-FR-003, SEC-NFR-002) ────────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_STRONG_256BIT_KEY
JWT_REFRESH_SECRET=CHANGE_ME_STRONG_REFRESH_KEY
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── MQTT Broker (SEC-NFR-001) ─────────────────────────────────────────────────
# Dev: cổng 1883 non-TLS (docker-compose.yml: "dev only, non-TLS") — tránh lỗi
# SELF_SIGNED_CERT_IN_CHAIN với cert tự ký của EMQX trên 8883. ESP32 vẫn publish
# qua 8883 (setInsecure()) — cùng broker, không ảnh hưởng nhau.
# Production: đổi lại mqtts://...:8883 + trỏ MQTT_CA_CERT_PATH tới CA cert thật.
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=backend-service
MQTT_PASSWORD=CHANGE_ME
MQTT_CA_CERT_PATH=./config/certs/ca.crt
# OTA firmware (FARM-FR-013, Flow 15): chỉ cho ESP32 tải firmware HTTPS từ các host này
# (phân cách bằng dấu phẩy, VD MinIO nội bộ). Để trống = chặn mọi lệnh OTA.
OTA_ALLOWED_HOSTS=
# Báo cáo sức khỏe Zone (EXPERT-FR-005): lịch tổng hợp (cron 6 trường của node-cron, mặc định 06:00 thứ Hai)
# và độ dài kỳ báo cáo tính theo ngày
HEALTH_REPORT_CRON=0 0 6 * * 1
HEALTH_REPORT_DAYS=7

# ── Live stream camera qua MediaMTX (VISION-FR-013, docs/bird-counting-plan.md §8.6) ──
# Để trống cả ba = chưa dựng máy chủ video: GET …/stream-token trả 503, MediaMTX bị từ chối mọi yêu cầu.
# STREAM_TOKEN_SECRET: ký token xem stream 60 giây — khóa riêng, KHÔNG dùng lại JWT_ACCESS_SECRET.
# STREAM_AUTH_KEY: MediaMTX gửi kèm ?key= khi hỏi quyền (MTX_AUTHHTTPADDRESS).
# STREAM_PUBLISH_SECRET: mật khẩu pipeline dùng để đẩy video lên và đọc hình gốc cam-<id>-raw.
# Production: mỗi biến một chuỗi ngẫu nhiên dài (openssl rand -hex 32).
STREAM_TOKEN_SECRET=
STREAM_AUTH_KEY=
STREAM_PUBLISH_SECRET=

# ── CORS (frontend Vite dev server) ───────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Reverse proxy (tuỳ chọn) ──────────────────────────────────────────────────
# Đặt khi backend chạy sau proxy/tunnel (Cloudflare, nginx) để req.ip — dùng cho
# audit_logs.ip_address và rate limit — là IP client thật thay vì IP của proxy.
# Giá trị: số hop proxy (VD 1), loopback/uniquelocal, hoặc danh sách IP/CIDR của proxy.
# Bỏ trống, false hoặc 0 = tắt. KHÔNG dùng true — sẽ tin X-Forwarded-For do client tự đặt
# (giả mạo được IP audit log, né rate limit) nên server từ chối khởi động.
# TRUST_PROXY=1

# ── MinIO / S3 (THREAT-FR-002, SEC-NFR-006) ───────────────────────────────────
# Cùng bucket chứa file loa ru upload qua web (ENV-FR-013c, key `audio-tracks/…`).
# Dev với docker-compose: ACCESS/SECRET = minioadmin / minioadmin123.
# MINIO_ENDPOINT phải là host mà TRÌNH DUYỆT truy cập được — URL nghe thử được ký theo host này.
# Chưa dựng MinIO? Đặt STORAGE_DRIVER=local để lưu file vào thư mục LOCAL_STORAGE_DIR
# (mặc định ./storage) và phục vụ ở GET /files/<key> — CHỈ dùng cho dev: file công khai,
# không cần đăng nhập. Bỏ dòng này (hoặc để trống) để dùng MinIO như bình thường.
# STORAGE_DRIVER=local
# LOCAL_STORAGE_DIR=storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=swiftletcare-snapshots

# ── Firebase FCM (ALERT-FR-002) ───────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json

# ── Telegram bot (ALERT-FR-013) — kênh thông báo ngoài ứng dụng chạy thật ──────
# Tạo bot qua @BotFather trên Telegram để lấy token + username. Để trống = không bật.
# Backend nhận /start bằng long polling nên chỉ chạy MỘT instance với cùng 1 token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ── Email (OTP) ───────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@swiftletcare.vn
SMTP_PASS=CHANGE_ME

# ── Zalo ZNS (ALERT-FR-003) ───────────────────────────────────────────────────
ZALO_OA_ACCESS_TOKEN=CHANGE_ME
ZALO_ZNS_TEMPLATE_CRITICAL=TEMPLATE_ID
ZALO_ZNS_TEMPLATE_HIGH=TEMPLATE_ID

# ── Rate Limiting (SEC-NFR-004) ───────────────────────────────────────────────
# Sau proxy/tunnel phải đặt TRUST_PROXY (mục Reverse proxy ở trên), nếu không mọi
# người dùng chưa đăng nhập và mọi lượt đăng nhập/refresh chung 1 suất theo IP của proxy.
# API đã đăng nhập: đếm theo tài khoản (không đăng nhập thì theo IP). 300 vì trang
# Tổng quan gọi API theo từng zone (~85 request/lần mở với farm 20 zone).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Đăng nhập / OTP / quên mật khẩu: đếm theo IP, chặt để chống dò mật khẩu và spam OTP.
# Đăng nhập, xác thực OTP, đặt lại mật khẩu chỉ đếm lần sai; gửi OTP đếm mọi lần.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
# /auth/refresh: suất riêng theo IP mỗi phút — không bị chặn lây khi tài khoản hết suất API
REFRESH_RATE_LIMIT_MAX=30
