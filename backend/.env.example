# ── App ────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME=SwiftletCare API

# ── MongoDB ────────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/swiftletcare
MONGODB_TEST_URI=mongodb://localhost:27017/swiftletcare_test

# ── Redis (for session / rate limiting) ───────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT (AUTH-FR-003, SEC-NFR-002) ────────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_STRONG_256BIT_KEY
JWT_REFRESH_SECRET=CHANGE_ME_STRONG_REFRESH_KEY
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── MQTT Broker (SEC-NFR-001) ─────────────────────────────────────────────────
MQTT_BROKER_URL=mqtts://localhost:8883
MQTT_USERNAME=backend-service
MQTT_PASSWORD=CHANGE_ME
MQTT_CA_CERT_PATH=./config/certs/ca.crt

# ── MinIO / S3 (THREAT-FR-002, SEC-NFR-006) ───────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=swiftletcare-snapshots

# ── Firebase FCM (ALERT-FR-002) ───────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json

# ── Email (OTP) ───────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@swiftletcare.vn
SMTP_PASS=CHANGE_ME

# ── Zalo ZNS (ALERT-FR-003) ───────────────────────────────────────────────────
ZALO_OA_ACCESS_TOKEN=CHANGE_ME
ZALO_ZNS_TEMPLATE_CRITICAL=TEMPLATE_ID
ZALO_ZNS_TEMPLATE_HIGH=TEMPLATE_ID

# ── Rate Limiting (SEC-NFR-004) ───────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
