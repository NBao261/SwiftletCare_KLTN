# ── App ────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME=SwiftletCare API

# ── MongoDB (user/pass root khớp docker-compose.yml ở gốc repo) ──────────────
MONGODB_URI=mongodb://admin:swiftletcare_dev@localhost:27017/swiftletcare?authSource=admin
MONGODB_TEST_URI=mongodb://admin:swiftletcare_dev@localhost:27017/swiftletcare_test?authSource=admin

# ── Redis (for session / rate limiting) ───────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT (AUTH-FR-003, SEC-NFR-002) ────────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_STRONG_256BIT_KEY
JWT_REFRESH_SECRET=CHANGE_ME_STRONG_REFRESH_KEY
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── MQTT Broker (SEC-NFR-001) ─────────────────────────────────────────────────
# Dev: cổng 1883 non-TLS (docker-compose.yml: "dev only, non-TLS") — tránh lỗi
# SELF_SIGNED_CERT_IN_CHAIN với cert tự ký của EMQX trên 8883. ESP32 vẫn publish
# qua 8883 (setInsecure()) — cùng broker, không ảnh hưởng nhau.
# Production: đổi lại mqtts://...:8883 + trỏ MQTT_CA_CERT_PATH tới CA cert thật.
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=backend-service
MQTT_PASSWORD=CHANGE_ME
MQTT_CA_CERT_PATH=./config/certs/ca.crt
# OTA firmware (TICKET-FR-008, Flow 15): chỉ cho ESP32 tải firmware HTTPS từ các host này
# (phân cách bằng dấu phẩy, VD MinIO nội bộ). Để trống = chặn mọi lệnh OTA.
OTA_ALLOWED_HOSTS=
# TICKET-FR-008: chỉ bật khi firmware đã xử lý trường `command` trong config/update.
# Chưa bật thì RESTART/OTA trả 501 thay vì báo "đã gửi" cho thiết bị không làm gì.
FIRMWARE_COMMAND_SUPPORT=false
# Bảo trì định kỳ (TICKET-FR-013): tạo ticket MAINTENANCE trước hạn bao nhiêu ngày
MAINTENANCE_LEAD_DAYS=3

# ── CORS (frontend Vite dev server) ───────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Reverse proxy (tuỳ chọn) ──────────────────────────────────────────────────
# Đặt khi backend chạy sau proxy/tunnel (Cloudflare, nginx) để req.ip — dùng cho
# audit_logs.ip_address và rate limit — là IP client thật thay vì IP của proxy.
# Giá trị: số hop proxy (VD 1), loopback/uniquelocal, hoặc danh sách IP/CIDR của proxy.
# Bỏ trống, false hoặc 0 = tắt. KHÔNG dùng true — sẽ tin X-Forwarded-For do client tự đặt
# (giả mạo được IP audit log, né rate limit) nên server từ chối khởi động.
# TRUST_PROXY=1

# ── MinIO / S3 (THREAT-FR-002, SEC-NFR-006) ───────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=swiftletcare-snapshots

# ── Firebase FCM (ALERT-FR-002) ───────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json

# ── Email (OTP) ───────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@swiftletcare.vn
SMTP_PASS=CHANGE_ME

# ── Zalo ZNS (ALERT-FR-003) ───────────────────────────────────────────────────
ZALO_OA_ACCESS_TOKEN=CHANGE_ME
ZALO_ZNS_TEMPLATE_CRITICAL=TEMPLATE_ID
ZALO_ZNS_TEMPLATE_HIGH=TEMPLATE_ID

# ── Rate Limiting (SEC-NFR-004) ───────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
