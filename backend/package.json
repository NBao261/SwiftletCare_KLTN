{
  "name": "swiftletcare-backend",
  "version": "1.0.0",
  "description": "SwiftletCare Cloud API – Node.js + Express + MongoDB + MQTT + Socket.io",
  "main": "src/index.js",
  "scripts": {
    "start":     "node src/index.js",
    "dev":       "nodemon src/index.js",
    "dev:debug": "nodemon --inspect src/index.js",
    "test":      "jest --coverage",
    "test:unit": "jest tests/unit --coverage",
    "test:int":  "jest tests/integration",
    "lint":      "eslint src/**/*.js",
    "pm2:start": "pm2 start src/index.js --name swiftletcare-api -i max",
    "pm2:stop":  "pm2 stop swiftletcare-api"
  },
  "dependencies": {
    "express":              "^4.19.2",
    "mongoose":             "^8.3.4",
    "socket.io":            "^4.7.5",
    "mqtt":                 "^5.6.0",
    "jsonwebtoken":         "^9.0.2",
    "bcryptjs":             "^2.4.3",
    "express-validator":    "^7.1.0",
    "express-rate-limit":   "^7.3.1",
    "helmet":               "^7.1.0",
    "cors":                 "^2.8.5",
    "morgan":               "^1.10.0",
    "dotenv":               "^16.4.5",
    "winston":              "^3.13.0",
    "firebase-admin":       "^12.1.0",
    "aws-sdk":              "^2.1632.0",
    "qrcode":               "^1.5.3",
    "node-cron":            "^3.0.3",
    "nodemailer":           "^6.9.13",
    "speakeasy":            "^2.0.0"
  },
  "devDependencies": {
    "nodemon":   "^3.1.3",
    "jest":      "^29.7.0",
    "supertest": "^7.0.0",
    "eslint":    "^8.57.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageThreshold": {
      "global": { "lines": 80 }
    },
    "testPathPattern": ["tests/unit", "tests/integration"]
  }
}
