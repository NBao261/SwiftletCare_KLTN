{
  "name": "swiftletcare-backend",
  "version": "1.0.0",
  "description": "SwiftletCare Cloud API – Node.js + Express + TypeScript + MongoDB + MQTT + Socket.io",
  "main": "dist/index.js",
  "scripts": {
    "start":      "node dist/index.js",
    "dev":        "tsx watch src/index.ts",
    "build":      "tsc",
    "build:check":"tsc --noEmit",
    "test":       "jest --coverage",
    "test:unit":  "jest tests/unit --coverage",
    "test:int":   "jest tests/integration",
    "lint":       "eslint src/**/*.ts",
    "pm2:start":  "pm2 start dist/index.js --name swiftletcare-api -i max",
    "pm2:stop":   "pm2 stop swiftletcare-api"
  },
  "dependencies": {
    "express":            "^4.19.2",
    "mongoose":           "^8.3.4",
    "socket.io":          "^4.7.5",
    "mqtt":               "^5.6.0",
    "jsonwebtoken":       "^9.0.2",
    "bcryptjs":           "^2.4.3",
    "express-validator":  "^7.1.0",
    "express-rate-limit": "^7.3.1",
    "helmet":             "^7.1.0",
    "cors":               "^2.8.5",
    "morgan":             "^1.10.0",
    "dotenv":             "^16.4.5",
    "winston":            "^3.13.0",
    "firebase-admin":     "^12.1.0",
    "aws-sdk":            "^2.1632.0",
    "qrcode":             "^1.5.3",
    "node-cron":          "^3.0.3",
    "nodemailer":         "^6.9.13",
    "speakeasy":          "^2.0.0"
  },
  "devDependencies": {
    "typescript":                  "^5.4.5",
    "tsx":                         "^4.15.6",
    "@types/node":                 "^20.14.0",
    "@types/express":              "^4.17.21",
    "@types/bcryptjs":             "^2.4.6",
    "@types/jsonwebtoken":         "^9.0.6",
    "@types/morgan":               "^1.9.9",
    "@types/cors":                 "^2.8.17",
    "@types/nodemailer":           "^6.4.15",
    "@types/qrcode":               "^1.5.5",
    "@types/speakeasy":            "^2.0.10",
    "jest":                        "^29.7.0",
    "ts-jest":                     "^29.1.5",
    "@types/jest":                 "^29.5.12",
    "supertest":                   "^7.0.0",
    "@types/supertest":            "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser":   "^7.13.0",
    "eslint":                      "^8.57.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "coverageThreshold": {
      "global": { "lines": 80 }
    }
  }
}
