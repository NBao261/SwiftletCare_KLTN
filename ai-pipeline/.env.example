# Sao thành ai-pipeline/.env (không commit). Plan mục 5, 16.3.

# Địa chỉ RTSP có mật khẩu camera. Để trống thì dùng camera.source trong config.yaml (file clip).
# Trong LAN nhà yến:   rtsp://admin:<mật khẩu>@192.168.1.163:554/stream1
# Từ xa qua IP public: rtsp://admin:<mật khẩu>@<WAN IP hoặc tên DDNS>:18554/stream1
CAMERA_RTSP_URL=

# device_id của CameraNode đã đăng ký ở backend (POST /devices/camera-nodes/register). Nhà yến của camera do
# backend giữ. MQTT_PASSWORD là broker_secret của thiết bị (lấy khi nhập kho hoặc `npm run device:broker-secret`)
CAMERA_DEVICE_ID=cam-house1-01
MQTT_PASSWORD=

# Đẩy hình đã vẽ khung lên MediaMTX (plan 15.6, 16.3). Để trống = không đẩy, chỉ có MJPEG trên máy.
# Mật khẩu = STREAM_PUBLISH_SECRET của backend; đường = cam-<CAMERA_DEVICE_ID>.
# Dev (docker compose up -d mediamtx): rtsp://pipeline:dev-publish@localhost:8554/cam-cam-house1-01
# Cloud: rtsps://pipeline:<STREAM_PUBLISH_SECRET>@<tên miền>:8322/cam-<device_id>
STREAM_PUSH_URL=
