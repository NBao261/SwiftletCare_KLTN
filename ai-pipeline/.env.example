# Sao thành ai-pipeline/.env (không commit). Plan mục 5, 16.3.

# Cài đặt nút AI thật: chạy `python tools/setup_node.py --server https://<tên miền>/api` với mã cài đặt tạo ở màn
# Kho thiết bị; công cụ tự ghi API_BASE_URL, CAMERA_DEVICE_ID, MQTT_PASSWORD, MQTT_BROKER/PORT/TLS và STREAM_PUSH_URL.
# Địa chỉ camera do Farm Owner nhập trên web, nút AI tự lấy (FARM-FR-004b): khi đó để trống CAMERA_RTSP_URL.

# Máy dev hoặc chạy clip: địa chỉ RTSP có mật khẩu camera, thắng địa chỉ trên web. Trống và không có API_BASE_URL
# thì dùng camera.source trong config.yaml (file clip).
# Trong LAN nhà yến:   rtsp://admin:<mật khẩu>@192.168.1.163:554/stream1
# Từ xa qua IP public: rtsp://admin:<mật khẩu>@<WAN IP hoặc tên DDNS>:18554/stream1
CAMERA_RTSP_URL=

# device_id của CameraNode đã đăng ký ở backend (POST /devices/camera-nodes/register). Nhà yến của camera do
# backend giữ. MQTT_PASSWORD là broker_secret của thiết bị (lấy khi nhập kho hoặc `npm run device:broker-secret`)
CAMERA_DEVICE_ID=cam-house1-01
MQTT_PASSWORD=

# Địa chỉ API của backend: nút AI lấy địa chỉ camera ở <API_BASE_URL>/agent/camera-source
API_BASE_URL=

# Broker của staging (setup_node.py ghi); trống thì dùng mqtt trong config.yaml
MQTT_BROKER=
MQTT_PORT=
MQTT_TLS=

# Đẩy hình đã vẽ khung lên MediaMTX (plan 15.6, 16.3). Để trống = không đẩy, chỉ có MJPEG trên máy.
# setup_node.py ghi sẵn địa chỉ kèm tài khoản riêng của nút AI. Cách cũ (đang bỏ dần): mật khẩu = STREAM_PUBLISH_SECRET
# của backend; đường = cam-<CAMERA_DEVICE_ID>.
# Dev (docker compose up -d mediamtx): rtsp://pipeline:dev-publish@localhost:8554/cam-cam-house1-01
# Cloud: rtsps://pipeline:<STREAM_PUBLISH_SECRET>@<tên miền>:8322/cam-<device_id>
STREAM_PUSH_URL=
