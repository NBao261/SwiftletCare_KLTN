    "socket.io-client":     "^4.7.5",
    "zustand":              "^4.5.2",
    "@tanstack/react-query": "^5.40.0",
    "chart.js":             "^4.4.3",
    "react-chartjs-2":      "^5.2.0",
    "video.js":             "^8.12.0",
    "html5-qrcode":         "^2.3.8",
    "jspdf":                "^2.5.1",
    "jspdf-autotable":      "^3.8.2",
    "date-fns":             "^3.6.0",
