{
  "name": "swiftletcare-frontend",
  "version": "1.0.0",
  "description": "SwiftletCare Web Dashboard & PWA – React 18 + Vite + TailwindCSS",
  "type": "module",
  "scripts": {
    "dev":     "vite",
